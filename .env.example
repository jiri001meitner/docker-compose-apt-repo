# Copy to .env (chmod 600) and fill in.

# Data root on the host:
#   db/      repo-admin SQLite (owner REPO_UID, 0700)
#   export/  clients.json read by repo-auth (owner REPO_UID, 0755)
#   aptly/   aptly root; public/ (repositories) and site/ (catalogue) are
#            served by the reverse proxy (owner SYNC_UID, 0755)
DATA_DIR=/srv/apt-repo

# repo-auth / repo-admin user. SOCKET_DIR must be owned by REPO_UID with
# group SOCKET_GID and mode 2750; SOCKET_GID is the reverse proxy group.
REPO_UID=10201
SOCKET_GID=
SOCKET_DIR=/run/repo-auth
#REPO_AUTH_REALM=APT repository

# repo-sync user and the armored repository signing key (owner SYNC_UID, 0400).
SYNC_UID=10200
SIGNING_KEY_FILE=/etc/apt-repo/signing-key.asc

# Network of repo-sync (defaults 172.30.0 and fd00:d0c:30)
#V4_PREFIX=172.30.0
#V6_PREFIX=fd00:d0c:30
